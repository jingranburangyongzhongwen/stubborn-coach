#!/usr/bin/env node
const fs = require('fs');
const path = require('path');
const { ensureInitialized, resolveWorkspacePath } = require('./lib/paths');
const { extractSource } = require('./lib/pdf-cli');

function jsonOut(payload, exitCode = 0) {
  process.stdout.write(`${JSON.stringify(payload)}\n`);
  process.exit(exitCode);
}

function commandError(command, error) {
  return {
    ok: false,
    command,
    error: {
      code: error.code || 'ERROR',
      message: error.message,
      details: error.details || {},
    },
  };
}

const HELP = {
  global: {
    usage: 'stubborn-coach <command>',
    commands: [],
    notes: [
      'stubborn-coach auto-creates learning-wiki/study.md and learning-wiki/.study-state.yml on first use.',
      'All learning state is owned by the study skill (LLM main flow). Hidden writer commands are not public API.',
    ],
  },
};

function helpPayload(topic) {
  return {
    ok: true,
    command: 'help',
    topic: topic || null,
    ...(HELP[topic] || HELP.global),
  };
}

function codedError(code, message, details = {}) {
  const error = new Error(message);
  error.code = code;
  error.details = details;
  return error;
}

function normalizeWithTrailingNewline(value) {
  const text = String(value || '');
  return text.endsWith('\n') ? text : `${text}\n`;
}

function ensureStudyExists(studyPath) {
  if (!fs.existsSync(studyPath)) {
    throw codedError('STUDY_MD_MISSING', '`learning-wiki/study.md` is missing; initialization should happen automatically before study reads or writes');
  }
}

function hasAnchor(value) {
  return /<!--\s*(?:topic:|node:|mistakes:)/.test(value);
}

function assertNoAnchor(value) {
  if (hasAnchor(value)) {
    throw codedError('INVALID_STDIN', 'stdin must not contain stubborn-coach comment anchors');
  }
}

function assertKebabId(value, label) {
  if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(value || '')) {
    throw codedError('INVALID_ARGS', `${label} must be kebab-case`);
  }
}

function assertSmallInt(value, label) {
  if (!/^(?:[1-9]|[1-9][0-9])$/.test(String(value || ''))) {
    throw codedError('INVALID_ARGS', `${label} must be an integer from 1 to 99`);
  }
}

function parseArgs(args) {
  const parsed = {};
  for (let index = 0; index < args.length; index += 2) {
    const key = args[index];
    const value = args[index + 1];
    if (!/^--[a-z-]+$/.test(key || '') || !value || parsed[key] !== undefined) {
      throw codedError('INVALID_ARGS', 'arguments must be unique flag/value pairs');
    }
    parsed[key] = value;
  }
  return parsed;
}

function requireOnlyArgs(parsed, allowed) {
  const keys = Object.keys(parsed).sort();
  const expected = [...allowed].sort();
  if (keys.join(',') !== expected.join(',')) {
    throw codedError('INVALID_ARGS', `expected arguments: ${expected.join(' ')}`);
  }
}

function extractTopicIds(yaml) {
  const text = String(yaml || '');
  const lines = text.split(/\r?\n/);
  const topicLine = lines.findIndex((line) => /^topics:\s*(?:\[\s*\])?\s*$/.test(line));
  if (topicLine < 0) return null;
  if (/^topics:\s*\[\s*\]\s*$/.test(lines[topicLine])) return [];
  const blockLines = [];
  for (let index = topicLine + 1; index < lines.length; index += 1) {
    const line = lines[index];
    if (/^[A-Za-z_][A-Za-z0-9_-]*:\s*/.test(line)) break;
    blockLines.push(line);
  }
  const block = blockLines.join('\n');
  const ids = [];
  for (const match of block.matchAll(/^\s*-\s+id:\s*["']?([a-z0-9]+(?:-[a-z0-9]+)*)["']?\s*$/gm)) {
    ids.push(match[1]);
  }
  return ids;
}

const Y_INT = /^["']?(\d+)["']?$/;
const Y_BOOL = /^["']?(true|false|yes|no|on|off)["']?$/i;
const yInt = (raw) => { const m = String(raw).trim().match(Y_INT); return m ? Number(m[1]) : null; };
const yBool = (raw) => { const m = String(raw).trim().match(Y_BOOL); return m ? /^(t|y|on)/i.test(m[1]) : null; };

function parseTopicsForInvariant(yaml) {
  const lines = String(yaml || '').split(/\r?\n/);
  const topicsLine = lines.findIndex((line) => /^topics:\s*(?:\[\s*\])?\s*$/.test(line));
  if (topicsLine < 0 || /^topics:\s*\[\s*\]\s*$/.test(lines[topicsLine])) return [];

  const topics = [];
  let topic = null;
  let inMap = false;
  let node = null;

  const closeNode = () => { if (node && topic) topic.nodes.push(node); node = null; };
  const closeTopic = () => { closeNode(); if (topic) topics.push(topic); topic = null; inMap = false; };

  const setField = (target, key, raw) => {
    if (key === 'idx' || key === 'current_node_idx') {
      const v = yInt(raw); if (v !== null) target[key] = v;
    } else if (key === 'done') {
      const v = yBool(raw); if (v !== null) target.done = v;
    }
  };

  for (let i = topicsLine + 1; i < lines.length; i += 1) {
    const line = lines[i];
    if (/^[A-Za-z_]/.test(line)) { closeTopic(); break; }

    const topicHead = line.match(/^ {2}- id:\s*(.+?)\s*$/);
    if (topicHead) {
      closeTopic();
      const id = topicHead[1].replace(/^["'](.*)["']$/, '$1');
      topic = { id, current_node_idx: null, nodes: [] };
      continue;
    }
    if (!topic) continue;

    const topicField = line.match(/^ {4}(current_node_idx):\s*(.+?)\s*$/);
    if (topicField) { setField(topic, topicField[1], topicField[2]); continue; }

    if (/^ {4}map:\s*$/.test(line)) { inMap = true; continue; }
    if (inMap && /^ {4}[A-Za-z_]/.test(line)) { closeNode(); inMap = false; }
    if (!inMap) continue;

    const nodeHead = line.match(/^ {6}- (idx|done):\s*(.*)$/);
    if (nodeHead) { closeNode(); node = { idx: null, done: false }; setField(node, nodeHead[1], nodeHead[2]); continue; }
    const nodeField = line.match(/^ {8}(idx|done):\s*(.+?)\s*$/);
    if (nodeField && node) setField(node, nodeField[1], nodeField[2]);
  }
  closeTopic();
  return topics;
}

function assertNodeProgression(yaml) {
  const topics = parseTopicsForInvariant(yaml);
  for (const topic of topics) {
    if (topic.current_node_idx == null || topic.nodes.length === 0) continue;
    const sorted = [...topic.nodes].filter((n) => n.idx != null).sort((a, b) => a.idx - b.idx);
    if (sorted.length === 0) continue;
    const trueCount = sorted.filter((n) => n.done).length;
    for (let i = 0; i < sorted.length; i += 1) {
      const expected = i < trueCount;
      if (sorted[i].done !== expected) {
        throw codedError(
          'STATE_NODE_DONE_NOT_PREFIX',
          `topic ${topic.id}: map[].done must be a true-prefix (all true nodes come before all false ones)`,
          { topic: topic.id },
        );
      }
    }
    if (topic.current_node_idx !== trueCount + 1) {
      throw codedError(
        'STATE_NODE_IDX_MISMATCH',
        `topic ${topic.id}: current_node_idx must equal (done-true count) + 1`,
        { topic: topic.id, expected: trueCount + 1, actual: topic.current_node_idx },
      );
    }
  }
}

function normalizeStateYaml(value) {
  const text = String(value || '');
  if (!text.trim()) throw codedError('EMPTY_STDIN', 'write-state requires YAML content on stdin');
  if (/^#/m.test(text)) throw codedError('INVALID_STATE_YAML', 'state YAML must not contain markdown headings');
  const typeLine = text.match(/^type:\s*(.+?)\s*$/m);
  if (typeLine && !/^["']?study-log["']?$/.test(typeLine[1])) {
    throw codedError('INVALID_STATE_YAML', 'state YAML type must be `study-log`');
  }
  return typeLine ? text : `type: study-log\n${text}`;
}

function assertValidStateYaml(value) {
  const text = normalizeStateYaml(value);
  if (extractTopicIds(text) === null) {
    throw codedError('INVALID_STATE_YAML', 'state YAML must contain `topics`');
  }
  assertNodeProgression(text);
  return { text };
}

function writeState(content = '') {
  const root = process.cwd();
  ensureInitialized(root);
  const statePath = resolveWorkspacePath('learning-wiki/.study-state.yml', { cwd: root, allowSourceFiles: false });
  const { text } = assertValidStateYaml(content);
  const normalized = normalizeWithTrailingNewline(text);
  fs.writeFileSync(statePath, normalized, 'utf8');
  return {
    written: [path.join('learning-wiki', '.study-state.yml')],
    bytes: Buffer.byteLength(normalized, 'utf8'),
  };
}

function appendBlockAtEnd(content, block) {
  const separator = content.endsWith('\n') ? '\n' : '\n\n';
  return `${content}${separator}${block.trimEnd()}\n`;
}

function insertBlockAt(content, index, block) {
  const before = content.slice(0, index);
  const after = content.slice(index);
  const prefix = before.endsWith('\n') ? '\n' : '\n\n';
  const suffix = after && !after.startsWith('\n') ? '\n' : '';
  return `${before}${prefix}${block.trimEnd()}\n${suffix}${after}`;
}

function insertLinesAt(content, index, lines) {
  const before = content.slice(0, index);
  const after = content.slice(index);
  const prefix = before.endsWith('\n') ? '' : '\n';
  const suffix = after && !after.startsWith('\n') ? '\n' : '';
  return `${before}${prefix}${lines.trimEnd()}\n${suffix}${after}`;
}

function readStudy(root) {
  const studyPath = resolveWorkspacePath('learning-wiki/study.md', { cwd: root, allowSourceFiles: false });
  ensureStudyExists(studyPath);
  return { studyPath, content: fs.readFileSync(studyPath, 'utf8') };
}

function findTopicBounds(content, topic) {
  const anchor = `<!-- topic:${topic} -->`;
  const start = content.indexOf(anchor);
  if (start < 0) throw codedError('TOPIC_NOT_FOUND', `topic not found: ${topic}`);
  const next = content.indexOf('\n<!-- topic:', start + anchor.length);
  return { start, end: next < 0 ? content.length : next };
}

function topicSlice(content, bounds) {
  return content.slice(bounds.start, bounds.end);
}

function maxNodeIdx(slice) {
  let max = 0;
  for (const match of slice.matchAll(/<!-- node:(\d+) -->/g)) {
    max = Math.max(max, Number(match[1]));
  }
  return max;
}

function findNodeBounds(content, topic, node) {
  const topicBounds = findTopicBounds(content, topic);
  const slice = topicSlice(content, topicBounds);
  const anchor = `<!-- node:${node} -->`;
  const nodeStartLocal = slice.indexOf(anchor);
  if (nodeStartLocal < 0) throw codedError('NODE_NOT_FOUND', `node not found: ${topic}/${node}`);
  const nextNodeLocal = slice.indexOf('\n<!-- node:', nodeStartLocal + anchor.length);
  const nodeEndLocal = nextNodeLocal < 0 ? slice.length : nextNodeLocal;
  return {
    start: topicBounds.start + nodeStartLocal,
    end: topicBounds.start + nodeEndLocal,
  };
}

// Walk lines, calling `transform` only on lines outside fenced code blocks
// (``` or ~~~ fences, 3+ of the same char). Fence markers are preserved verbatim.
// This keeps heading normalization from mangling `# comment` / `## title` inside
// shell / markdown code examples in lecture bodies.
function mapLinesOutsideFences(text, transform) {
  const lines = text.split('\n');
  let fenceChar = null;
  for (let i = 0; i < lines.length; i += 1) {
    const line = lines[i];
    if (fenceChar === null) {
      const open = line.match(/^(`{3,}|~{3,})/);
      if (open) {
        fenceChar = open[1][0];
      } else {
        lines[i] = transform(line);
      }
    } else if (new RegExp(`^\\${fenceChar}{3,}\\s*$`).test(line)) {
      fenceChar = null;
    }
  }
  return lines.join('\n');
}

function findFirstHeadingLevelOutsideFences(text) {
  const lines = text.split('\n');
  let fenceChar = null;
  for (const line of lines) {
    if (fenceChar === null) {
      const open = line.match(/^(`{3,}|~{3,})/);
      if (open) { fenceChar = open[1][0]; continue; }
      const h = line.match(/^(#+)\s+\S/);
      if (h) return h[1].length;
    } else if (new RegExp(`^\\${fenceChar}{3,}\\s*$`).test(line)) {
      fenceChar = null;
    }
  }
  return null;
}

// Normalize so the first markdown heading sits at `targetTopLevel`, shifting every
// other heading by the same delta. Lets stdin authors pick any consistent depth
// (`# Topic` or `### Topic`) without having to remember the canonical level.
function shiftHeadingsToTopLevel(text, targetTopLevel) {
  const firstLevel = findFirstHeadingLevelOutsideFences(text);
  if (firstLevel === null) return text;
  const shift = targetTopLevel - firstLevel;
  if (shift === 0) return text;
  return mapLinesOutsideFences(text, (line) => {
    const m = line.match(/^(#{1,6})(\s+\S.*)$/);
    if (!m) return line;
    const newLevel = m[1].length + shift;
    if (newLevel < 1 || newLevel > 6) return line;
    return '#'.repeat(newLevel) + m[2];
  });
}

// Numbered headings like `### 1. basic meaning` always represent node headings
// regardless of what depth the author picked, so force them to h5 after any shift.
// This saves authors from having to get the topic-to-node level delta right.
function forceNumberedNodeHeadings(text) {
  return mapLinesOutsideFences(text, (line) => {
    const m = line.match(/^#+(\s+\d+\. .*)$/);
    if (!m) return line;
    return `#####${m[1]}`;
  });
}

function injectNodeOneAnchor(value) {
  const text = normalizeWithTrailingNewline(value);
  const lines = text.split('\n');
  let fenceChar = null;
  let cursor = 0;
  let nodeCharIdx = -1;
  for (const line of lines) {
    if (fenceChar === null) {
      const open = line.match(/^(`{3,}|~{3,})/);
      if (open) {
        fenceChar = open[1][0];
      } else if (/^##### 1\. .+$/.test(line)) {
        nodeCharIdx = cursor;
        break;
      }
    } else if (new RegExp(`^\\${fenceChar}{3,}\\s*$`).test(line)) {
      fenceChar = null;
    }
    cursor += line.length + 1;
  }
  if (nodeCharIdx < 0) {
    throw codedError('INVALID_TOPIC_STDIN', 'add-topic stdin must include node 1 lecture headed by `1. {label}`');
  }
  const before = text.slice(0, nodeCharIdx);
  const after = text.slice(nodeCharIdx);
  const prefix = before.endsWith('\n') ? '' : '\n';
  return `${before}${prefix}<!-- node:1 -->\n${after}`;
}

// Pull off the first non-empty line as the topic title, stripping any leading
// `#` markers the author may have added. Returns { title, body }.
// This way the stdin schema is "title line + sections", with section heading
// levels normalized by the CLI — authors never decide what depth `### {title}`
// sits at, removing the heading-level dimension that LLMs kept getting wrong.
function splitTitleFromTopicStdin(raw) {
  const lines = raw.split(/\r?\n/);
  let titleIdx = -1;
  for (let i = 0; i < lines.length; i += 1) {
    if (lines[i].trim()) { titleIdx = i; break; }
  }
  if (titleIdx < 0) return { title: '', body: '' };
  const titleLine = lines[titleIdx].replace(/^#+\s*/, '').trim();
  const body = lines.slice(titleIdx + 1).join('\n');
  return { title: titleLine, body };
}

function addTopic(args, content = '') {
  const root = process.cwd();
  ensureInitialized(root);
  const parsed = parseArgs(args);
  requireOnlyArgs(parsed, ['--id']);
  const id = parsed['--id'];
  assertKebabId(id, '--id');
  const raw = String(content || '');
  if (!raw.trim()) throw codedError('EMPTY_STDIN', 'add-topic requires markdown content on stdin');
  const { title, body } = splitTitleFromTopicStdin(raw);
  if (!title) {
    throw codedError('INVALID_TOPIC_STDIN', 'add-topic stdin first non-empty line must be the topic title');
  }
  // Section headings (学习目标 / 学习地图 / 节点讲义) shift to h4; numbered node
  // headings then get pinned to h5 regardless of what the author picked.
  const normalizedBody = forceNumberedNodeHeadings(shiftHeadingsToTopLevel(body, 4));
  const value = `### ${title}\n${normalizedBody.startsWith('\n') ? normalizedBody : `\n${normalizedBody}`}`;
  assertNoAnchor(value);

  const { studyPath, content: current } = readStudy(root);
  if (current.includes(`<!-- topic:${id} -->`)) {
    throw codedError('TOPIC_EXISTS', `topic already exists: ${id}`);
  }
  const withNodeAnchor = injectNodeOneAnchor(value);
  const normalized = appendBlockAtEnd(current, `<!-- topic:${id} -->\n${withNodeAnchor}`);
  fs.writeFileSync(studyPath, normalized, 'utf8');
  return {
    written: [path.join('learning-wiki', 'study.md')],
    bytes: Buffer.byteLength(normalized, 'utf8'),
  };
}

function readStateTopicsOrThrow(root) {
  const statePath = path.join(root, 'learning-wiki', '.study-state.yml');
  if (!fs.existsSync(statePath)) {
    throw codedError('STATE_MISSING', '`learning-wiki/.study-state.yml` is missing; write-state must run before add-node');
  }
  return parseTopicsForInvariant(fs.readFileSync(statePath, 'utf8'));
}

function assertPrevNodeDone(root, topicId, idx) {
  const topic = readStateTopicsOrThrow(root).find((t) => t.id === topicId);
  if (!topic) {
    throw codedError('STATE_TOPIC_NOT_FOUND', `topic ${topicId} not in state.yml; write-state must run before add-node`, { topic: topicId });
  }
  const prev = topic.nodes.find((n) => n.idx === idx - 1);
  if (!prev || !prev.done) {
    throw codedError(
      'NODE_PREREQUISITE_NOT_DONE',
      `add-node --idx ${idx} requires done[${idx - 1}]=true in state.yml; only call add-node from P1 after a passing probe lands write-state with done[${idx - 1}]=true and current_node_idx=${idx}`,
      { topic: topicId, expected_done: idx - 1 },
    );
  }
}

function addNode(args, content = '') {
  const root = process.cwd();
  ensureInitialized(root);
  const parsed = parseArgs(args);
  requireOnlyArgs(parsed, ['--topic', '--idx']);
  const topic = parsed['--topic'];
  const idx = Number(parsed['--idx']);
  assertKebabId(topic, '--topic');
  assertSmallInt(parsed['--idx'], '--idx');
  const raw = String(content || '');
  if (!raw.trim()) throw codedError('EMPTY_STDIN', 'add-node requires markdown content on stdin');
  const headingMatch = raw.trimStart().match(/^(#+)\s+(\d+)\. /);
  if (!headingMatch) {
    throw codedError('INVALID_NODE_STDIN', `add-node stdin must start with a heading like \`${idx}. {label}\``);
  }
  if (Number(headingMatch[2]) !== idx) {
    throw codedError('INVALID_NODE_STDIN', `add-node stdin heading number must match --idx ${idx}`, { stdin_idx: Number(headingMatch[2]), arg_idx: idx });
  }
  const value = forceNumberedNodeHeadings(shiftHeadingsToTopLevel(raw, 5));
  assertNoAnchor(value);

  const { studyPath, content: current } = readStudy(root);
  const bounds = findTopicBounds(current, topic);
  const slice = topicSlice(current, bounds);
  if (slice.includes(`<!-- node:${idx} -->`)) {
    throw codedError('NODE_EXISTS', `node already exists: ${topic}/${idx}`);
  }
  const max = maxNodeIdx(slice);
  if (max !== idx - 1) {
    throw codedError('NODE_IDX_MISMATCH', `node idx must be ${max + 1}`, { expected: max + 1, actual: idx });
  }
  assertPrevNodeDone(root, topic, idx);
  const normalized = insertBlockAt(current, bounds.end, `<!-- node:${idx} -->\n${normalizeWithTrailingNewline(value)}`);
  fs.writeFileSync(studyPath, normalized, 'utf8');
  return {
    written: [path.join('learning-wiki', 'study.md')],
    bytes: Buffer.byteLength(normalized, 'utf8'),
  };
}

function addMistake(args, content = '') {
  const root = process.cwd();
  ensureInitialized(root);
  const parsed = parseArgs(args);
  requireOnlyArgs(parsed, ['--topic', '--node']);
  const topic = parsed['--topic'];
  const node = Number(parsed['--node']);
  assertKebabId(topic, '--topic');
  assertSmallInt(parsed['--node'], '--node');
  const value = String(content || '');
  const lines = value.trimEnd().split(/\r?\n/).filter((line) => line.length > 0);
  if (!lines.length) throw codedError('EMPTY_STDIN', 'add-mistake requires markdown list items on stdin');
  if (!lines.every((line) => /^- /.test(line))) {
    throw codedError('INVALID_MISTAKE_STDIN', 'add-mistake stdin lines must all start with `- `');
  }
  assertNoAnchor(value);

  const { studyPath, content: current } = readStudy(root);
  const nodeBounds = findNodeBounds(current, topic, node);
  const nodeSlice = current.slice(nodeBounds.start, nodeBounds.end);
  const mistakeAnchor = `<!-- mistakes:${topic}/${node} -->`;
  const mistakeStartLocal = nodeSlice.indexOf(mistakeAnchor);
  const normalized = mistakeStartLocal < 0
    ? insertBlockAt(current, nodeBounds.end, `${mistakeAnchor}\n###### 错题\n${lines.join('\n')}`)
    : insertLinesAt(current, nodeBounds.end, lines.join('\n'));
  fs.writeFileSync(studyPath, normalized, 'utf8');
  return {
    written: [path.join('learning-wiki', 'study.md')],
    bytes: Buffer.byteLength(normalized, 'utf8'),
  };
}

function computeSm2(args) {
  const parsed = parseArgs(args);
  requireOnlyArgs(parsed, ['--quality', '--ease', '--interval', '--reps', '--today']);
  const quality = Number(parsed['--quality']);
  const today = parsed['--today'];
  if (!Number.isInteger(quality) || quality < 0 || quality > 5) {
    throw codedError('INVALID_ARGS', '--quality must be an integer from 0 to 5');
  }
  if (!/^\d{4}-\d{2}-\d{2}$/.test(today)) {
    throw codedError('INVALID_ARGS', '--today must be YYYY-MM-DD');
  }
  let ease = Number(parsed['--ease']);
  let reps = Number(parsed['--reps']);
  let intv = Number(parsed['--interval']);
  if (!Number.isFinite(ease) || ease < 1.3) ease = 2.5;
  if (!Number.isInteger(reps) || reps < 0) reps = 0;
  if (!Number.isInteger(intv) || intv < 0) intv = 0;

  if (quality < 3) {
    reps = 0;
    intv = 1;
  } else {
    reps = reps + 1;
    if (reps === 1) {
      intv = 1;
    } else if (reps === 2) {
      intv = quality === 5 ? 6 : 3;
    } else {
      intv = Math.max(1, Math.round(intv * ease));
    }
    ease = Math.max(1.3, ease + (0.1 - (5 - quality) * (0.08 + (5 - quality) * 0.02)));
  }

  const todayDate = new Date(`${today}T00:00:00Z`);
  const nextDate = new Date(todayDate);
  nextDate.setUTCDate(nextDate.getUTCDate() + intv);
  const nextReview = nextDate.toISOString().slice(0, 10);

  let status;
  if (quality >= 4) status = 'met_target';
  else if (quality < 3) status = 'needs_review';
  else status = 'in_progress';

  return {
    last_reviewed: today,
    next_review: nextReview,
    interval_days: intv,
    repetitions: reps,
    ease_factor: Math.round(ease * 100) / 100,
    status,
  };
}

function main() {
  const [command, ...args] = process.argv.slice(2);
  try {
    if (!command || ['-h', '--help'].includes(command)) {
      jsonOut(helpPayload());
    }

    if (command === 'help') {
      jsonOut(helpPayload(args[0]));
    }

    if (command === 'write-state') {
      const input = fs.readFileSync(0, 'utf8');
      const result = writeState(input);
      jsonOut({ ok: true, command, written: result.written, bytes: result.bytes, warnings: [] });
    }

    if (command === 'add-topic') {
      const input = fs.readFileSync(0, 'utf8');
      const result = addTopic(args, input);
      jsonOut({ ok: true, command, written: result.written, bytes: result.bytes, warnings: [] });
    }

    if (command === 'add-node') {
      const input = fs.readFileSync(0, 'utf8');
      const result = addNode(args, input);
      jsonOut({ ok: true, command, written: result.written, bytes: result.bytes, warnings: [] });
    }

    if (command === 'add-mistake') {
      const input = fs.readFileSync(0, 'utf8');
      const result = addMistake(args, input);
      jsonOut({ ok: true, command, written: result.written, bytes: result.bytes, warnings: [] });
    }

    if (command === 'compute-sm2') {
      const result = computeSm2(args);
      jsonOut({ ok: true, command, ...result });
    }

    if (command === 'extract-source') {
      const parsed = parseArgs(args);
      requireOnlyArgs(parsed, ['--name']);
      const input = fs.readFileSync(0, 'utf8');
      extractSource({ name: parsed['--name'] }, input)
        .then((result) => jsonOut({ command, ...result }))
        .catch((error) => jsonOut(commandError(command, error), 1));
      return;
    }

    const error = new Error(`unknown command: ${command}`);
    error.code = 'UNKNOWN_COMMAND';
    error.details = { hint: 'Initialization is automatic. Public CLI commands are intentionally hidden from normal use.' };
    throw error;
  } catch (error) {
    jsonOut(commandError(command || 'unknown', error), 1);
  }
}

if (require.main === module) {
  main();
}

module.exports = {
  addMistake,
  addNode,
  addTopic,
  computeSm2,
  main,
  writeState,
};
